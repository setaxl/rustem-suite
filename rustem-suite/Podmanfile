# ===========================================================================
# RUSTEM SUITE — Imagen de producción (Podman, Fedora Rawhide, rootless)
# ===========================================================================
# Construcción multi-stage: compilación en stage de build, ejecución en
# stage runtime con usuario no root y sin dependencias de C/C++.
#
# Uso:
#   podman build -t rustem-suite:latest .
#   podman run --rm -p 8080:8080 \
#       -e DATABASE_URL=ws://surrealdb:8000/rpc \
#       -e DATABASE_USER=root -e DATABASE_PASS=root \
#       -e NAMESPACE=rustem -e DATABASE_NAME=suite \
#       rustem-suite:latest
# ===========================================================================

FROM fedora:rawhide AS builder

# Dependencias de compilación (solo herramientas del ecosistema Rust,
# sin gcc, sin openssl-devel, sin toolchains de C/C++).
RUN dnf -y install \
        cargo \
        rustc \
        clang \
        lld \
        pkgconf \
        protobuf-devel \
    && dnf clean all

WORKDIR /build
COPY . .

RUN cargo build --release --offline --bin rustem-web

# ---------------------------------------------------------------------------
FROM fedora:rawhide AS runtime

RUN dnf -y install \
        ca-certificates \
        tzdata \
    && dnf clean all \
    && groupadd -g 1000 rustem \
    && useradd -u 1000 -g 1000 -m -s /sbin/nologin rustem

WORKDIR /app

COPY --from=builder /build/target/release/rustem-web /app/rustem-web
COPY --from=builder /build/static /app/static
COPY --from=builder /build/migrations /app/migrations

USER rustem

EXPOSE 8080/tcp

ENV DATABASE_URL=ws://surrealdb:8000/rpc \
    DATABASE_USER=root \
    DATABASE_PASS=root \
    NAMESPACE=rustem \
    DATABASE_NAME=suite \
    RUST_LOG=info \
    RUSTEM_BASE_URL=http://localhost:8080

CMD ["/app/rustem-web"]
